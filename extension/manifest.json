{
  "manifest_version": 3,
  "name": "Watch Together - Pink Edition 🍿🌸",
  "version": "1.0.0",
  "description": "Synchronized anime and movie watch party for Prince & Friend on HiAnime, Netflix, Crunchyroll, and any streaming site.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Watch Together Sync"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.hianime.to/*",
        "*://*.hianime.nz/*",
        "*://*.aniwatchtv.to/*",
        "*://*.kaido.to/*",
        "*://*.gogoanime3.co/*",
        "*://*.crunchyroll.com/*",
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.megacloud.tv/*",
        "*://*.rapid-cloud.co/*",
        "*://*/*"
      ],
      "js": [
        "socket.io.min.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
