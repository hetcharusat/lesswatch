# ==============================================================================
# Watch Together - Self-Hosted Environment Configuration
# Copy this file to .env and customize before running: docker compose up -d
# ==============================================================================

# Arr-stack style user/group & timezone settings
PUID=1000
PGID=1000
TZ=UTC

# Watch Together web port
PORT=3000

# Persistent host paths for config/database/users and downloaded media
DATA_PATH=./data
DOWNLOADS_PATH=./downloads

# LiveKit Voice SFU credentials (generate a strong secret for production!)
LIVEKIT_API_KEY=watchtogether
LIVEKIT_API_SECRET=change-this-to-a-long-random-secret-key
LIVEKIT_URL=ws://livekit:7880
# Optional: override the browser WebSocket URL if using an external LiveKit host
# LIVEKIT_WS_URL=wss://watch.example.com/livekit

# Optional AES-256-GCM vault key override (if unset, an instance key is auto-generated in config.json)
# VAULT_SECRET=

# Optional SubDL API key for subtitle search
# SUBDL_API_KEY=

# Optional Profile: Caddy Reverse Proxy (docker compose --profile caddy up -d)
# Use :80 for local HTTP, or your.domain.com for automatic Let's Encrypt HTTPS
CADDY_DOMAIN=:80
CADDY_EMAIL=admin@example.com

# Optional Profile: Neko Shared Browser (docker compose --profile neko up -d)
NEKO_CONTAINER_NAME=neko
NEKO_IMAGE=ghcr.io/m1k1o/neko/chromium:3.2.0
NEKO_URL=http://neko:8080
NEKO_PASSWORD=admin
NEKO_ADMIN_PASSWORD=admin
# High quality HD + 60fps butter-smooth default (switchable to 1080p in Neko menu)
NEKO_DESKTOP_SCREEN=1280x720@60
NEKO_MEMORY_LIMIT=3072m
NEKO_MEMORY_RESERVATION=1024m
# Encoder bitrate/preset live in neko.yaml (legacy NEKO_MAX_FPS is unused).
# Set to your server's public/LAN IP if Neko WebRTC is used across networks
# NEKO_NAT1TO1=
NEKO_ICELITE=0
NEKO_WEBRTC_ICELITE=0
NEKO_WEBRTC_ICESERVERS_FRONTEND='[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:openrelay.metered.ca:443?transport=tcp","turn:openrelay.metered.ca:80","turn:openrelay.metered.ca:443"],"username":"openrelayproject","credential":"openrelayproject"}]'
NEKO_WEBRTC_ICESERVERS_BACKEND='[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:openrelay.metered.ca:443?transport=tcp","turn:openrelay.metered.ca:80","turn:openrelay.metered.ca:443"],"username":"openrelayproject","credential":"openrelayproject"}]'

