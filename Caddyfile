{$CADDY_DOMAIN::80} {
    @notMedia not path /api/media/stream/* /api/media/audio/* /api/media/hls/* /api/media/subtitles/*
    encode @notMedia gzip zstd

    # LiveKit WebSocket signaling proxy (strips /livekit prefix)
    handle_path /livekit* {
        reverse_proxy livekit:7880
    }

    # Main Watch Together app, /neko (auto-started & gated), and Socket.IO (/api/v1/sync)
    reverse_proxy watch-together:3000
}
